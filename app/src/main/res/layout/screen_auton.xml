<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/autonFieldContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_general">

    <!-- ═════════════════════════════════════════
     TIMER & BUTTON BOX (bottom)
     ═════════════════════════════════════════ -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/timerWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal|bottom"
        android:orientation="vertical"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ═════════════════════════════════════════
        TIMER
        ═════════════════════════════════════════ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/TimerBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/IDAutonSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/timer"
                android:drawablePadding="@dimen/drawable_padding"
                android:fontFamily="@font/futura_medium_condensed_bt"
                android:text="@string/AutonSeconds"
                android:textColor="@color/sky"
                android:textSize="@dimen/instruction_text_size"
                app:layout_constraintBottom_toTopOf="parent" />

            <TextView
                android:id="@+id/AutonSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/DefaultValue"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/instruction_text_size"
                app:layout_constraintStart_toEndOf="@+id/IDAutonSeconds" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- Timer Warning -->
        <TextView
            android:id="@+id/TeleopWarning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/teleop_warning"
            android:fontFamily="@font/open_sans"
            android:text="@string/TeleopWarning"
            android:textColor="@color/charcoal"
            android:textSize="@dimen/input_label_text_size"
            android:visibility="invisible"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/FixedBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:layout_marginHorizontal="20dp"
        android:orientation="vertical"
        android:gravity="center_horizontal|bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/IDStartDirections"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="12dp"
            android:enabled="true"
            android:fontFamily="@font/open_sans"
            android:gravity="center"
            android:text="Press SAVE after each task the robot attempts."
            android:textColor="@drawable/text_states"
            android:textSize="@dimen/input_label_text_size"
            app:drawableStartCompat="@drawable/start_directions_symbol_states"
            app:layout_constraintBottom_toTopOf="@+id/StartButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Divider -->
        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/TimerBox" />

        <!-- ═════════════════════════════════════════
             BUTTONS
             ═════════════════════════════════════════ -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ButtonBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center|bottom"
            app:layout_constraintStart_toEndOf="parent" >

            <Button
                android:id="@+id/ResetButton"
                android:layout_width="200dp"
                android:layout_height="54dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/button_large_states"
                android:text="@string/Reset"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size"
                app:backgroundTint="@color/midnight" />

            <Button
                android:id="@+id/SaveButton"
                android:layout_width="550dp"
                android:layout_height="54dp"
                android:background="@drawable/button_large_active"
                android:backgroundTint="@null"
                app:backgroundTint="@null"
                android:text="@string/Save"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size"/>

            <Button
                android:id="@+id/NextTeleopButton"
                android:layout_width="200dp"
                android:layout_height="54dp"
                android:layout_marginStart="20dp"
                android:paddingHorizontal="12dp"
                android:text="TELEOP"
                android:textColor="@android:color/white"
                android:textSize="@dimen/button_text_size"
                android:background="@drawable/button_large_states"
                app:backgroundTint="@null"
                app:icon="@drawable/right_states"
                app:iconGravity="textEnd"
                app:iconTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/autonTimerBar" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- ═════════════════════════════════════════
         COLUMN ONE
         ═════════════════════════════════════════ -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ColumnOne"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="30dp"
        android:layout_marginVertical="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ═════════════════════════════════════════
         SCORING TITLE
         ═════════════════════════════════════════ -->

        <TextView
            android:id="@+id/ScoringTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/futura_medium_condensed_bt"
            android:text="@string/ScoringTitle"
            android:textColor="@drawable/text_header_states"
            android:textSize="@dimen/header_text_size"
            app:layout_constraintBottom_toTopOf="@+id/StartTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/CollectingDesc"
            android:layout_width="600dp"
            android:layout_height="wrap_content"
            android:text="@string/ScoringDesc"
            android:textColor="@color/cloud"
            android:textSize="@dimen/instruction_text_size"
            android:textStyle="italic"
            app:layout_constraintTop_toBottomOf="@+id/CollectingTitle" />

    <!-- ═════════════════════════════════════════
     SCORED AND MISSED ROW
     ═════════════════════════════════════════ -->

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ScoringRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/CollectingCounterToggle">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ScoredCol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/ScoredTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/futura_medium_condensed_bt"
                    android:text="@string/Scored"
                    android:textColor="@color/sky"
                    android:textSize="@dimen/subheader_text_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- ═════════════════════════════════════════
                     SCORED SECTION
                     ═════════════════════════════════════════ -->

                <RadioGroup
                    android:id="@+id/ScoredCounterToggle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="@id/ScoringDesc"
                    app:layout_constraintTop_toBottomOf="@+id/ScoringDesc">

                    <RadioButton
                        android:id="@+id/ScoredMinus10"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/counter_left_button_states"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:text="-10"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />

                    <RadioButton
                        android:id="@+id/ScoredMinus"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:background="@drawable/counter_left_button_states_no_corners"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:text="-1"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />

                    <EditText
                        android:id="@+id/ScoredCounter"
                        android:layout_width="75dp"
                        android:layout_height="@dimen/button_height"
                        android:background="@drawable/edittext_rounded_corners"
                        android:fontFamily="@font/open_sans"
                        android:hint="@string/DefaultValue"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:tag=""
                        android:textColor="@color/charcoal"
                        android:textColorHint="@color/night"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginHorizontal="5dp"
                        app:layout_constraintStart_toEndOf="@+id/ScoredMinus"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!--<RadioButton
                        android:id="@+id/ScoredCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:checked="false"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="@string/DefaultValue"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />-->

                    <RadioButton
                        android:id="@+id/ScoredPlus"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/counter_right_button_states_no_corners"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="+1"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />

                    <RadioButton
                        android:id="@+id/ScoredPlus10"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/counter_right_button_states"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:text="+10"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />
                </RadioGroup>
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- ═════════════════════════════════════════
             MISSED SECTION
             ═════════════════════════════════════════ -->
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/MissedCol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="25dp"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/MissedTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/futura_medium_condensed_bt"
                    android:text="@string/MissedTitle"
                    android:textColor="@color/sky"
                    android:textSize="@dimen/subheader_text_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="parent" />

                <!-- Missed counter toggle: -10 | -5 | - | 000 | + | +5 | +10 -->
                <RadioGroup
                    android:id="@+id/MissedCounterToggle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="@id/MissedDesc"
                    app:layout_constraintTop_toBottomOf="@+id/MissedDesc">

                    <RadioButton
                        android:id="@+id/MissedMinus10"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/counter_left_button_states"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:text="-10"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />

                    <RadioButton
                        android:id="@+id/MissedMinus"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:background="@drawable/counter_left_button_states_no_corners"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:text="-1"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />

                    <!--<RadioButton
                        android:id="@+id/MissedCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:button="@null"
                        android:checked="false"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:padding="12dp"
                        android:text="@string/DefaultValue"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />-->

                    <EditText
                        android:id="@+id/MissedCounter"
                        android:layout_width="75dp"
                        android:layout_height="@dimen/button_height"
                        android:background="@drawable/edittext_rounded_corners"
                        android:fontFamily="@font/open_sans"
                        android:hint="@string/DefaultValue"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:tag=""
                        android:textColor="@color/charcoal"
                        android:textColorHint="@color/night"
                        android:gravity="center"
                        android:padding="12dp"
                        android:layout_marginHorizontal="5dp"
                        app:layout_constraintStart_toEndOf="@+id/MissedMinus"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RadioButton
                        android:id="@+id/MissedPlus"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/counter_right_button_states_no_corners"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:padding="8dp"
                        android:text="+1"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />

                    <RadioButton
                        android:id="@+id/MissedPlus10"
                        android:layout_width="@dimen/button_height"
                        android:layout_height="@dimen/button_height"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/counter_right_button_states"
                        android:button="@null"
                        android:fontFamily="@font/open_sans"
                        android:gravity="center"
                        android:text="+10"
                        android:textColor="@drawable/text_states"
                        android:textSize="@dimen/button_text_size" />
                </RadioGroup>
            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat> <!-- Divider -->
        <View
            android:id="@+id/div"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="20dp"
            android:background="@color/night"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ScoredRow" />

        <!-- ═════════════════════════════════════════
             FERRYING SECTION
             ═════════════════════════════════════════ -->
        <TextView
            android:id="@+id/FerryingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/futura_medium_condensed_bt"
            android:text="@string/Ferrying"
            android:textColor="@drawable/text_header_states"
            android:textSize="@dimen/header_text_size"
            app:layout_constraintStart_toStartOf="@id/CollectingDesc"
            app:layout_constraintTop_toBottomOf="@+id/CollectingCounterToggle" />

        <TextView
            android:id="@+id/FerryingDesc"
            android:layout_width="580dp"
            android:layout_height="wrap_content"
            android:text="@string/FerryingInstructions"
            android:textColor="@color/cloud"
            android:textSize="@dimen/instruction_text_size"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="@+id/FerryingCounterToggle"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/FerryingTitle"
            app:layout_constraintTop_toBottomOf="@+id/FerryingTitle" />

        <!-- Ferrying counter toggle: -10 | -5 | - | 000 | + | +5 | +10 -->
        <RadioGroup
            android:id="@+id/FerryingCounterToggle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="15dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/FerryingDesc"
            app:layout_constraintTop_toBottomOf="@+id/FerryingDesc">

            <RadioButton
                android:id="@+id/FerryingMinus10"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="1dp"
                android:background="@drawable/counter_left_button_states_no_corners"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:text="-10"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <RadioButton
                android:id="@+id/FerryingMinus5"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="1dp"
                android:background="@drawable/counter_left_button_states_no_corners"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:text="-5"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <!--<RadioButton
                android:id="@+id/FerryingCounter"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:button="@null"
                android:checked="false"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/DefaultValue"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />-->

            <EditText
                android:id="@+id/FerryingCounter"
                android:layout_width="75dp"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/edittext_rounded_corners"
                android:fontFamily="@font/open_sans"
                android:hint="@string/DefaultValue"
                android:importantForAutofill="no"
                android:inputType="number"
                android:tag=""
                android:textColor="@color/charcoal"
                android:textColorHint="@color/night"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginHorizontal="5dp"
                app:layout_constraintStart_toEndOf="@+id/FerryingMinus5"
                app:layout_constraintTop_toTopOf="parent" />

            <RadioButton
                android:id="@+id/FerryingPlus5"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="1dp"
                android:background="@drawable/counter_right_button_states_no_corners"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:text="+5"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <RadioButton
                android:id="@+id/FerryingPlus10"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/counter_right_button_states"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:text="+10"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />
        </RadioGroup>

        <View
            android:id="@+id/div2"
            android:layout_width="300dp"
            android:layout_height="2dp"
            android:layout_marginTop="15dp"
            android:background="@color/night"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/SuccessfullyClimbedLocation" />

        <!--Fell Over Switch-->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/SwitchWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/PreloadWrapper">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/NoShowSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                app:thumbTint="@color/thumb_states"
                app:trackDecoration="@null"
                app:trackTint="@color/track_states" />

            <TextView
                android:id="@+id/NoShowText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/open_sans"
                android:text="@string/RobotFellOver"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- ═════════════════════════════════════════
     COLUMN TWO  (right column)
     ═════════════════════════════════════════ -->

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ColumnTwo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="30dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- ═════════════════════════════════════════
         CLIMBING SECTION  (right column, below Missed)
         ═════════════════════════════════════════ -->

        <TextView
            android:id="@+id/ClimbingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/futura_medium_condensed_bt"
            android:text="@string/ClimbingTitle"
            android:textColor="@drawable/text_header_states"
            android:textSize="@dimen/header_text_size"
            app:layout_constraintBottom_toTopOf="@+id/StartLevelToggle"
            app:layout_constraintStart_toStartOf="@+id/ScoringTitle"
            app:layout_constraintTop_toBottomOf="@+id/StartTitle" />

        <TextView
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="@string/ClimbInstructions"
            android:textColor="@color/cloud"
            android:textSize="@dimen/instruction_text_size"
            android:textStyle="italic"
            app:layout_constraintTop_toBottomOf="@+id/CollectingTitle" />

        <TextView
            android:id="@+id/AttemptTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/futura_medium_condensed_bt"
            android:text="@string/AttemptedCLimbLevelDesc"
            android:textColor="@color/sky"
            android:textSize="@dimen/subheader_text_size"
            app:layout_constraintStart_toStartOf="@+id/StopLevelToggle"
            app:layout_constraintTop_toBottomOf="@+id/StopLevelToggle" />

        <!-- Did Not Attempt | 1 -->
        <RadioGroup
            android:id="@+id/AttemptedClimbToggle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="left|center"
            app:layout_constraintStart_toStartOf="@+id/ClimbingDesc"
            app:layout_constraintTop_toBottomOf="@+id/ClimbingDesc">

            <RadioButton
                android:id="@+id/AttemptedNo"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="1dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/toggle_left_states"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:text="@string/DNA"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <RadioButton
                android:id="@+id/AttemptedOne"
                android:layout_width="@dimen/button_height"
                android:layout_height="@dimen/button_height"
                android:paddingHorizontal="10dp"
                android:background="@drawable/toggle_right_states"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:text="1"
                android:gravity="center"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />
               -->
        </RadioGroup>

        <!-- Successful Climbed: None | 1 -->

        <TextView
            android:id="@+id/SuccessTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:enabled="false"
            android:fontFamily="@font/futura_medium_condensed_bt"
            android:text="@string/SuccessfullyClimbed"
            android:textColor="@drawable/text_states"
            android:textSize="@dimen/subheader_text_size"
            app:layout_constraintStart_toStartOf="@+id/StopLevelToggle"
            app:layout_constraintTop_toBottomOf="@+id/StopLevelToggle" />

        <RadioGroup
            android:id="@+id/SuccessfulClimbed"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="left|center"
            app:layout_constraintStart_toStartOf="@+id/SuccessfullyClimbed"
            app:layout_constraintTop_toBottomOf="@+id/SuccessfullyClimbed">

            <RadioButton
                android:id="@+id/DidNotAttempt"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="1dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/toggle_left_states"
                android:button="@null"
                android:enabled="false"
                android:fontFamily="@font/open_sans"
                android:text="@string/SuccessfulClimbedLevel"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <RadioButton
                android:id="@+id/AchievedLevel1"
                android:layout_width="@dimen/button_height"
                android:layout_height="match_parent"
                android:paddingHorizontal="10dp"
                android:background="@drawable/toggle_right_states"
                android:button="@null"
                android:enabled="false"
                android:fontFamily="@font/open_sans"
                android:text="1"
                android:gravity="center"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <!-- Teleop/Endgame only
            <RadioButton
                android:id="@+id/AchievedLevel1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="10dp"
                android:minWidth="45dp"
                android:background="@drawable/button_states"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:text="2"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <RadioButton
                android:id="@+id/AchievedLevel1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="10dp"
                android:minWidth="45dp"
                android:background="@drawable/button_states"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:text="3"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />
            -->
        </RadioGroup>

        <!-- Tower Climb Location: LEFT | CENTER | RIGHT -->
        <TextView
            android:id="@+id/locationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/futura_medium_condensed_bt"
            android:text="@string/TowerClimbPlacement"
            android:textColor="@drawable/text_subead_states"
            android:textSize="@dimen/subheader_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/SuccessfulClimbed"
            app:layout_constraintTop_toBottomOf="@+id/SuccessfulClimbed" />

        <RadioGroup
            android:id="@+id/SuccessfullyClimbedLocation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="left|center"
            app:layout_constraintStart_toStartOf="@+id/TowerClimbPlacement"
            app:layout_constraintTop_toBottomOf="@+id/TowerClimbPlacement">

            <RadioButton
                android:id="@+id/Left"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/toggle_left_states"
                android:button="@null"
                android:enabled="false"
                android:fontFamily="@font/open_sans"
                android:text="@string/Left"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <RadioButton
                android:id="@+id/Center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="1dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/counter_right_button_states_no_corners"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:enabled="false"
                android:text="@string/Center"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />

            <RadioButton
                android:id="@+id/Right"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:paddingHorizontal="12dp"
                android:layout_marginEnd="1dp"
                android:background="@drawable/toggle_right_states"
                android:button="@null"
                android:fontFamily="@font/open_sans"
                android:enabled="false"
                android:text="@string/Right"
                android:textColor="@drawable/text_states"
                android:textSize="@dimen/button_text_size" />
        </RadioGroup>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- ═════════════════════════════════════════
     EDGE BARS
     ═════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/leftEdgeBar"
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/teleop_warning"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/rightEdgeBar"
        android:layout_width="5dp"
        android:layout_height="0dp"
        android:alpha="0"
        android:background="@drawable/teleop_warning"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/topEdgeBar"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:alpha="0"
        android:background="@drawable/teleop_warning"
        app:layout_constraintEnd_toStartOf="@id/rightEdgeBar"
        app:layout_constraintStart_toEndOf="@id/leftEdgeBar"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/bottomEdgeBar"
        android:layout_width="0dp"
        android:layout_height="5dp"
        android:alpha="0"
        android:background="@drawable/teleop_warning"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/rightEdgeBar"
        app:layout_constraintStart_toStartOf="@+id/leftEdgeBar" />

</androidx.constraintlayout.widget.ConstraintLayout>